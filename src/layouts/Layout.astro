---
// one family: Host Grotesk, light and very large for the voice, regular for reading
import '@fontsource-variable/host-grotesk'
import '../styles/global.css'
import { getImage } from 'astro:assets'
import cover from '../assets/photos/corner.webp'

interface Props { title: string; description: string; lang: string }
const { title, description, lang } = Astro.props
const og = await getImage({ src: cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' })
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- Design concept: not indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#121513" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:image" content={new URL(og.src, Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}media/hero-d.webp`} media="(min-aspect-ratio: 1/1)" />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}media/hero-m.webp`} media="(max-aspect-ratio: 1/1)" />
    <title>{title}</title>
    <script is:inline>
      // Tier before first paint: static = reduced motion or very weak device (stills, last frame),
      // medium = touch or <=4 cores (native scroll, fewer frames), high = desktop with Lenis smoothing.
      (() => {
        const n = navigator, m = (q) => matchMedia(q).matches
        const tier = m('(prefers-reduced-motion: reduce)') || n.connection?.saveData || (n.deviceMemory && n.deviceMemory <= 2) || (n.hardwareConcurrency || 8) <= 2
          ? 'static' : m('(pointer: coarse)') || (n.hardwareConcurrency || 8) <= 4 ? 'medium' : 'high'
        const forced = new URLSearchParams(location.search).get('tier')
        document.documentElement.dataset.tier = forced || tier
        document.documentElement.classList.add('t-' + (forced || tier))
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
